FROM python:3.13-slim AS verify

WORKDIR /source
COPY owner_cloud ./owner_cloud
COPY tests/test_owner_cloud_security.py ./tests/test_owner_cloud_security.py
RUN python -B -m unittest discover -s tests -p "test_owner_cloud_security.py" -v

FROM python:3.13-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CYBERDEFENDER_OWNER_HOST=0.0.0.0 \
    CYBERDEFENDER_OWNER_DB=/data/owner.db \
    CYBERDEFENDER_DEBUG=0
COPY owner_cloud ./owner_cloud
CMD ["python", "-m", "owner_cloud.server"]
