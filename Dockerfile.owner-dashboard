FROM python:3.13-slim AS verify

WORKDIR /source
COPY . .
RUN python scripts/scan_repository_secrets.py \
    && python -B -m unittest \
        tests.test_owner_cloud_security \
        tests.test_owner_distribution_client_security -v \
    && touch /security-tests-passed

FROM python:3.13-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CYBERDEFENDER_OWNER_HOST=0.0.0.0 \
    CYBERDEFENDER_OWNER_DB=/data/owner.db \
    CYBERDEFENDER_DEBUG=0
COPY owner_cloud ./owner_cloud
COPY --from=verify /security-tests-passed /security-tests-passed
CMD ["python", "-m", "owner_cloud.server"]
